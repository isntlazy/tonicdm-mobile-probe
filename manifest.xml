<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
           xsi:type="MailApp">

  <!-- Throwaway probe add-in. Sole purpose: confirm an add-in renders in Outlook
       on iOS/Android and report what the mobile host actually supports. -->
  <Id>36ae14b6-99f6-4d9f-aa72-9bd9dcc899f7</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>TonicDM</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="TonicDM Mobile Probe" />
  <Description DefaultValue="Throwaway add-in used to verify mobile rendering and report host capabilities." />

  <IconUrl DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://help.tonicdm.com/" />

  <AppDomains>
    <AppDomain>https://isntlazy.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/index.html" />
        <RequestedHeight>300</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!-- ReadItem keeps sideloading friction low; the probe needs nothing more. -->
  <Permissions>ReadItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="probeGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="probeButtonV10">
                  <Label resid="ProbeLabel" />
                  <Supertip>
                    <Title resid="ProbeLabel" />
                    <Description resid="ProbeDescription" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16" />
                    <bt:Image size="32" resid="Icon32" />
                    <bt:Image size="80" resid="Icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="ProbeUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-25.png" />
        <bt:Image id="Icon32" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-32.png" />
        <bt:Image id="Icon80" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="ProbeUrl" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/index.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="TonicDM Probe" />
        <bt:String id="ProbeLabel" DefaultValue="Mobile Probe" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ProbeDescription" DefaultValue="Open the TonicDM mobile probe." />
      </bt:LongStrings>
    </Resources>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.3">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="probeGroup">
                  <Label resid="GroupLabel" />
                  <Control xsi:type="Button" id="probeButton">
                    <Label resid="ProbeLabel" />
                    <Supertip>
                      <Title resid="ProbeLabel" />
                      <Description resid="ProbeDescription" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon16" />
                      <bt:Image size="32" resid="Icon32" />
                      <bt:Image size="80" resid="Icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="ProbeUrl" />
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>

          <!-- The bit that makes it appear on iOS/Android.
               No OfficeTab, no Supertip, MobileButton controls, 25/32/48 icons. -->
          <MobileFormFactor>
            <FunctionFile resid="FunctionFileUrl" />
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="mobileProbeGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="MobileButton" id="mobileProbeButton">
                  <Label resid="ProbeLabel" />
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="Icon25" />
                    <bt:Image size="25" scale="2" resid="Icon48" />
                    <bt:Image size="25" scale="3" resid="Icon80" />

                    <bt:Image size="32" scale="1" resid="Icon32" />
                    <bt:Image size="32" scale="2" resid="Icon64" />
                    <bt:Image size="32" scale="3" resid="Icon96" />

                    <bt:Image size="48" scale="1" resid="Icon48" />
                    <bt:Image size="48" scale="2" resid="Icon96" />
                    <bt:Image size="48" scale="3" resid="Icon144" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="ProbeUrl" />
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon16" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-25.png" />
          <bt:Image id="Icon25" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-25.png" />
          <bt:Image id="Icon32" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-32.png" />
          <bt:Image id="Icon48" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-48.png" />
          <bt:Image id="Icon64" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-64.png" />
          <bt:Image id="Icon80" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-80.png" />
          <bt:Image id="Icon96" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-96.png" />
          <bt:Image id="Icon144" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/assets/icon-144.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="ProbeUrl" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/index.html" />
          <bt:Url id="FunctionFileUrl" DefaultValue="https://isntlazy.github.io/tonicdm-mobile-probe/function-file.html" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="TonicDM Probe" />
          <bt:String id="ProbeLabel" DefaultValue="Mobile Probe" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="ProbeDescription" DefaultValue="Open the TonicDM mobile probe." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
